# The @deepseek-ai/* packages this plugin binds to are provided by the running
# harness at runtime; the copies npm installs here exist for local
# type-checking and bundling only. Their published peer graphs are locked to a
# harness generation (for example @deepseek-ai/dsh-client-runtime's peers still
# demand the 0.1.1-rc.2 line while the current line is 0.1.5-rc.2), so npm's
# peer auto-install and peer conflict detection reject a tree that is correct at
# runtime. Skipping peer resolution keeps `npm install` / `npm ci`
# reproducible from devDependencies alone.
legacy-peer-deps=true
